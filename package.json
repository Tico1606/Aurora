{
  "name": "ai-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "migrate": "bunx supabase db push --linked",
    "seed:db": "bunx supabase db push --linked --include-seed",
    "seed:auth": "bun ./scripts/seed-auth.ts",
    "seed": "bun run seed:db && bun run seed:auth",
    "reset": "bunx supabase db reset --linked --yes && bun run seed:auth",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "pages:dev": "npx wrangler pages dev .vercel/output/static",
    "pages:deploy": "npx wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.56.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "next": "15.5.2",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "6.0.3",
    "shadcn": "4.2.0",
    "sharp": "0.35.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "validator-brazil": "1.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@cloudflare/next-on-pages": "1.13.16",
    "@tailwindcss/postcss": "4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.1.5",
    "jsdom": "27.2.0",
    "tailwindcss": "4",
    "typescript": "5",
    "vitest": "4.1.5",
    "wrangler": "4.124.0"
  },
  "ignoreScripts": ["sharp", "unrs-resolver"],
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
